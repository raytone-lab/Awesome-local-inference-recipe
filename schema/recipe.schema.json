{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Inference Recipe",
 "type": "object",
 "required": [
  "id",
  "category",
  "model",
  "engine",
  "hardware",
  "source_url",
  "source_level",
  "model_family",
  "tags"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z-]+-[0-9a-z-]+$"
  },
  "category": {
   "enum": [
    "text",
    "image",
    "video-audio"
   ]
  },
  "model": {
   "type": "string"
  },
  "quant": {
   "type": [
    "string",
    "null"
   ]
  },
  "engine": {
   "type": "string"
  },
  "hardware": {
   "type": "string"
  },
  "hardware_family": {
   "enum": [
    "Mac",
    "NVIDIA 消费级",
    "DGX Spark",
    "AMD",
    "二手数据中心卡",
    "其他"
   ]
  },
  "hardware_cost_text": {
   "type": [
    "string",
    "null"
   ]
  },
  "hardware_cost_usd": {
   "type": [
    "number",
    "null"
   ]
  },
  "metric": {
   "type": [
    "string",
    "null"
   ]
  },
  "tok_s": {
   "type": [
    "number",
    "null"
   ]
  },
  "concurrency": {
   "type": [
    "string",
    "null"
   ]
  },
  "context": {
   "type": [
    "string",
    "null"
   ]
  },
  "launch_command": {
   "type": [
    "string",
    "null"
   ]
  },
  "source_url": {
   "type": "string",
   "pattern": "^https?://"
  },
  "source_note": {
   "type": [
    "string",
    "null"
   ]
  },
  "source_level": {
   "enum": [
    "官方",
    "实测",
    "转述",
    "宣称"
   ]
  },
  "date": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "x_post": {
   "type": "object",
   "properties": {
    "author": {
     "type": "string"
    },
    "likes": {
     "type": "integer"
    },
    "reposts": {
     "type": "integer"
    },
    "as_of": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  },
  "en": {
   "type": "object",
   "description": "English text for Chinese-language fields, shown in English mode",
   "properties": {
    "quant": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "hardware": {
     "type": "string"
    },
    "context": {
     "type": "string"
    },
    "concurrency": {
     "type": "string"
    },
    "engine_note": {
     "type": "string"
    },
    "hardware_cost_text": {
     "type": "string"
    },
    "source_note": {
     "type": "string"
    },
    "launch_command": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "metric_en": {
   "type": [
    "string",
    "null"
   ]
  },
  "engine_raw": {
   "type": "string",
   "description": "original engine string before normalization"
  },
  "engine_note": {
   "type": "string",
   "description": "version/flags/fork details split from engine"
  },
  "model_family": {
   "type": "string"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "streams": {
   "type": "array",
   "description": "per-concurrency aggregate decode throughput as published",
   "items": {
    "type": "object",
    "required": [
     "n",
     "tok_s"
    ],
    "properties": {
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "tok_s": {
      "type": "number"
     }
    },
    "additionalProperties": false
   }
  },
  "measured_by": {
   "type": [
    "string",
    "null"
   ],
   "description": "who ran the benchmark (X handle / org); differs from source author for reproductions"
  },
  "engine_fork": {
   "type": [
    "string",
    "null"
   ],
   "description": "fork owner/name when engine is a fork, e.g. \"PrismML\""
  },
  "source_id": {
   "type": "string",
   "pattern": "^src-[0-9a-f]{10}$",
   "description": "stable hash of source_url; rows sharing a source share it"
  },
  "superseded_by": {
   "type": [
    "string",
    "null"
   ],
   "description": "id of a newer recipe from the same author that replaces this one"
  }
 },
 "additionalProperties": false
}
